rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Security Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Validates that if 'uid' is present in the payload, it matches the authenticated owner's UID
    function hasValidUid(userId) {
      return !('uid' in request.resource.data) || request.resource.data.uid == userId;
    }

    // Ensures the 'uid' ownership field cannot be altered or transferred during updates
    function uidImmutable() {
      return !('uid' in request.resource.data) || !('uid' in resource.data) || request.resource.data.uid == resource.data.uid;
    }

    // --- User Space Isolation ---
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && hasValidUid(userId);
      allow update: if isOwner(userId) && hasValidUid(userId) && uidImmutable();
      allow delete: if isOwner(userId);

      // 1. User profile and global preferences document
      // Path: /users/{userId}/profile/data
      match /profile/{docId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && hasValidUid(userId);
        allow update: if isOwner(userId) && hasValidUid(userId) && uidImmutable();
        allow delete: if isOwner(userId);
      }

      // 2. Complete atomic snapshot for reliable single-operation backup and recovery
      // Path: /users/{userId}/backup/data
      match /backup/{docId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && hasValidUid(userId);
        allow update: if isOwner(userId) && hasValidUid(userId) && uidImmutable();
        allow delete: if isOwner(userId);
      }

      // 3. Classes Hub saved classes, watch progress, and search history
      // Path: /users/{userId}/classes/data
      match /classes/{docId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && hasValidUid(userId);
        allow update: if isOwner(userId) && hasValidUid(userId) && uidImmutable();
        allow delete: if isOwner(userId);
      }

      // 4. Individual study plans (subjects, chapters, topics, tasks, targets, sessions)
      // Path: /users/{userId}/study_plans/{planId}
      match /study_plans/{planId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && hasValidUid(userId);
        allow update: if isOwner(userId) && hasValidUid(userId) && uidImmutable();
        allow delete: if isOwner(userId);
      }

      // 5. Individual digital notebooks (pages, stylus drawing strokes, tables, images)
      // Path: /users/{userId}/notebooks/{notebookId}
      match /notebooks/{notebookId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && hasValidUid(userId);
        allow update: if isOwner(userId) && hasValidUid(userId) && uidImmutable();
        allow delete: if isOwner(userId);
      }

      // Recursive protection for any future subcollections under this user
      match /{allSubcollections=**} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && hasValidUid(userId);
        allow update: if isOwner(userId) && hasValidUid(userId) && uidImmutable();
        allow delete: if isOwner(userId);
      }
    }

    // Default deny: Strictly block all unauthenticated and public access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
