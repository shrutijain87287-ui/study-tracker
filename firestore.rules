rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Root user document: Only the authenticated owner can access
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // 1. User profile and global preferences document
      // Path: /users/{userId}/profile/data
      match /profile/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // 2. Complete atomic snapshot for reliable single-operation backup and recovery
      // Path: /users/{userId}/backup/data
      match /backup/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // 3. Classes Hub saved classes, watch progress, and search history
      // Path: /users/{userId}/classes/data
      match /classes/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // 4. Individual study plans (subjects, chapters, topics, tasks, targets, sessions)
      // Path: /users/{userId}/study_plans/{planId}
      match /study_plans/{planId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // 5. Individual digital notebooks (pages, stylus drawing strokes, tables, images)
      // Path: /users/{userId}/notebooks/{notebookId}
      match /notebooks/{notebookId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Recursive protection for any future subcollections under this user
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Default deny: Strictly block all unauthenticated and public access
    match /{document=**} {
      allow read, write: false;
    }
  }
}
